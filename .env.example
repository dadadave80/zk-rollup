# PROOF_MODE picks the proof TYPE the sp1-script asks SP1 for: mock or groth16.
# The orchestrator overrides this per script (demo / demo:groth16 / demo:sepolia).
PROOF_MODE=mock

# SP1_PROVER picks the BACKEND that actually computes the proof:
#   mock     — instant, returns empty/degenerate bytes (only valid with PROOF_MODE=mock)
#   cpu      — local CPU, real Groth16 takes ~5min on 12 cores
#   network  — Succinct prover network (needs NETWORK_PRIVATE_KEY below)
#   cuda     — local GPU, fastest if you have it
# Leave unset and the orchestrator picks the right default for the chosen
# PROOF_MODE. Only set this if you specifically want to override (e.g.
# SP1_PROVER=network to skip the local trusted-setup download).
# SP1_PROVER=cpu

L1_RPC_URL=http://localhost:8545
L1_CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

ROLLUP_ADDRESS=
SP1_VERIFIER_ADDRESS=
PROGRAM_VKEY=
GENESIS_ROOT=

SEQUENCER_URL=http://localhost:7001
PROVER_SVC_URL=http://localhost:7002

NETWORK_PRIVATE_KEY=
